# --- Entornos virtuales ---
venv/
.venv/
env/
ENV/

# --- Bytecode y cachés de Python ---
__pycache__/
*.py[cod]
*$py.class

# --- Cachés de herramientas ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/

# --- Cobertura de tests ---
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# --- Empaquetado / build ---
build/
mouse_cache/
dist/
*.egg-info/
*.egg
wheels/
pip-wheel-metadata/
*.whl
*.txt

# --- Configuraciones guardadas con `mousectl save` ---
# No se ignoran por defecto (el nombre de archivo lo eliges tú al guardar).
# Si alguna contiene mapeos que prefieres no versionar, ignórala puntualmente:
#   echo "mi_configuracion.json" >> .gitignore

# --- Editores ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Sistema operativo ---
.DS_Store
Thumbs.db

# --- Variables de entorno / secretos (por si algún día aplica) ---
.env
.env.*
